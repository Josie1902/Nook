# ─────────────────────────────
# Frontend Requirements
# ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
FRONTEND_PORT=3000

# ─────────────────────────────
# Application Config
# ─────────────────────────────
MAX_PDF_SIZE_MB=20
PROCESS_CONFIG_VERSION=v0-init

# ─────────────────────────────
# Better Auth
# ─────────────────────────────
BETTER_AUTH_SECRET=xxx
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

GMAIL_USERNAME=xxx
GMAIL_PASSWORD=xxx

# ─────────────────────────────
# Database
# ─────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_DB=nook
POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ─────────────────────────────
# S3 storage --> SeaweedFS
# ─────────────────────────────
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ADMIN_PORT=23646
S3_ENDPOINT_URL=http://seaweedfs-s3:8333
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET=books
S3_REGION=us-east-1

# ─────────────────────────────
# Message Broker --> Worker Sys
# ─────────────────────────────
REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=xxx
RABBITMQ_DEFAULT_PASS=xxx
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

CELERY_BROKER_URL=xxx
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─────────────────────────────
# Metadata Service
# ─────────────────────────────
GOOGLE_BOOKS_API_KEY=xxx

# ─────────────────────────────
# LLM Config
# ─────────────────────────────
LLM__PROVIDER=ollama

LLM__OLLAMA__BASE_URL=http://host.docker.internal:11434

LLM__OPENAI__API_KEY=xxx
LLM__OPENAI__BASE_URL=https://api.openai.com/v1

# Metadata extraction
LLM__METADATA__MODEL=llama3.2:3b
LLM__METADATA__TEMPERATURE=0
LLM__METADATA__THINKING=false
LLM__METADATA__TIMEOUT_SECONDS=120